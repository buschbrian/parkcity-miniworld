{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parkcity-miniworld",
  "main": "deploy/worker.js",
  "compatibility_date": "2026-11-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "deploy/site",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "TILES",
      "bucket_name": "parkcity-miniworld-tiles"
    }
  ]
}
